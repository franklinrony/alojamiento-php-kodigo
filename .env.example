# Configuración global del sistema y base de datos
DB_HOST=localhost
DB_NAME=alojamientos
DB_USER=root
DB_PASS=secret
DB_PORT=3306
APP_ENV=development
APP_DEBUG=true

PHP_ERROR_REPORTING=E_ALL
PHP_DISPLAY_ERRORS=On
PHP_MEMORY_LIMIT=256M
# Configuración PHP para entorno de desarrollo
PHP_ERROR_REPORTING=E_ALL
PHP_DISPLAY_ERRORS=On
PHP_MEMORY_LIMIT=512M

# Configuración general de la aplicación
APP_NAME="Alojamientos Kodigo"
APP_VERSION="1.0.0"
APP_URL="http://localhost:8000"
APP_TIMEZONE="America/El_Salvador"

# Habilitar/deshabilitar logging (true/false)
LOG_ENABLED=true

# Nivel de debug (true/false)
APP_DEBUG=true