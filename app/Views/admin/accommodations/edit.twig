{% extends "layouts/admin.twig" %}

{% block content %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center mb-4">Editar Alojamiento</h1>
            <p class="text-center text-muted mb-5">Modifica la información del alojamiento #{{ accommodation.id }}</p>
            
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h2 class="card-title">Información del Alojamiento</h2>
                        </div>
                        <div class="card-body">

                            {% if flash.error %}
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    {{ flash.error[0] }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            {% endif %}

                            <form method="POST" action="/admin/accommodations/{{ accommodation.id }}/update">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="name" class="form-label">Nombre del Alojamiento *</label>
                                            <input type="text" class="form-control" id="name" name="name" 
                                                   value="{{ accommodation.name }}" required maxlength="100">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="location" class="form-label">Ubicación *</label>
                                            <input type="text" class="form-control" id="location" name="location" 
                                                   value="{{ accommodation.location }}" required maxlength="150">
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="description" class="form-label">Descripción</label>
                                    <textarea class="form-control" id="description" name="description" 
                                              rows="4" placeholder="Describe las características del alojamiento...">{{ accommodation.description }}</textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="price" class="form-label">Precio por Noche (USD) *</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input type="number" class="form-control" id="price" name="price" 
                                                       value="{{ accommodation.price }}" step="0.01" min="0" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <a href="/admin/accommodations" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-2"></i>Cancelar
                                    </a>
                                    <button type="submit" class="btn btn-warning">
                                        <i class="bi bi-check-circle me-2"></i>Actualizar Alojamiento
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
