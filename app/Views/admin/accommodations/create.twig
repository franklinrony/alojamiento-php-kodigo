{% extends "layouts/admin.twig" %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">Crear Nuevo Alojamiento</h1>
                <a href="/admin/accommodations" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Volver a la Lista
                </a>
            </div>

            {% if flash.error %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ flash.error[0] }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}

            <div class="card">
                <div class="card-body">
                    <form method="POST" action="/admin/accommodations/store">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label for="name" class="form-label">Nombre del Alojamiento *</label>
                                    <input type="text" class="form-control" id="name" name="name" 
                                           placeholder="Ej: Casa de Playa en Cancún" required maxlength="100">
                                </div>

                                <div class="mb-3">
                                    <label for="description" class="form-label">Descripción</label>
                                    <textarea class="form-control" id="description" name="description" 
                                              rows="4" placeholder="Describe las características del alojamiento..."></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="location" class="form-label">Ubicación *</label>
                                            <input type="text" class="form-control" id="location" name="location" 
                                                   placeholder="Ej: Cancún, Quintana Roo" required maxlength="150">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="price" class="form-label">Precio por Noche (USD) *</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input type="number" class="form-control" id="price" name="price" 
                                                       placeholder="0.00" step="0.01" min="0" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">Información</h6>
                                        <p class="card-text small text-muted">
                                            Los campos marcados con * son obligatorios. 
                                            El alojamiento será creado y estará disponible inmediatamente.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/admin/accommodations" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-2"></i>Crear Alojamiento
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
