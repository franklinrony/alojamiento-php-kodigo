{% extends "layouts/simple.twig" %}

{% block title %}Gestionar Alojamientos - Alojamientos{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-2">Gestionar Alojamientos</h2>
                    <p class="text-muted">
                        Administra todos los alojamientos del sistema
                        {% if accommodations|length > 0 %}
                            <span class="badge bg-primary ms-2">{{ accommodations|length }} alojamiento{{ accommodations|length != 1 ? 's' : '' }}</span>
                        {% endif %}
                    </p>
                </div>
                <a href="/admin/accommodation/add" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Agregar Alojamiento
                </a>
            </div>

            {% if accommodations|length > 0 %}
                <div class="row g-4">
                    {% for accommodation in accommodations %}
                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="card-title mb-0 text-primary">{{ accommodation.name }}</h5>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#"><i class="bi bi-pencil me-2"></i>Editar</a></li>
                                            <li><a class="dropdown-item text-danger" href="#" data-bs-toggle="modal" data-bs-target="#deleteModal{{ accommodation.id }}"><i class="bi bi-trash me-2"></i>Eliminar</a></li>
                                        </ul>
                                    </div>
                                </div>
                                
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-geo-alt me-1"></i>{{ accommodation.location }}
                                </p>
                                
                                {% if accommodation.description %}
                                    <p class="card-text small text-muted mb-3 flex-grow-1">
                                        {{ accommodation.description|slice(0, 100) }}{% if accommodation.description|length > 100 %}...{% endif %}
                                    </p>
                                {% endif %}
                                
                                <div class="mt-auto">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-success fs-5">${{ accommodation.price|number_format(2) }}</span>
                                        <small class="text-muted">por noche</small>
                                    </div>
                                    
                                    {% if accommodation.creator %}
                                        <div class="border-top pt-2">
                                            <small class="text-muted">
                                                <i class="bi bi-person me-1"></i>Creado por: {{ accommodation.creator.name }}
                                            </small>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-house-door text-muted" style="font-size: 4rem;"></i>
                    <h4 class="text-muted mt-3">No hay alojamientos registrados</h4>
                    <p class="text-muted mb-4">Comienza agregando tu primer alojamiento</p>
                    <a href="/admin/accommodation/add" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Agregar Primer Alojamiento
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Delete Modals -->
{% for accommodation in accommodations %}
<div class="modal fade" id="deleteModal{{ accommodation.id }}" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar el alojamiento <strong>"{{ accommodation.name }}"</strong>?</p>
                <p class="text-muted small">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form action="/admin/accommodation/delete/{{ accommodation.id }}" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}
