{% extends "layouts/main.twig" %}

{% block content %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Bienvenido al Panel de Administración</h2>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card mb-4">
                                <div class="card-body text-center">
                                    <h5 class="card-title">Alojamientos</h5>
                                    <p class="display-4">{{ accommodations_count|default(0) }}</p>
                                    <a href="{{ path_for('admin.accommodations') }}" class="btn btn-primary">Gestionar Alojamientos</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card mb-4">
                                <div class="card-body text-center">
                                    <h5 class="card-title">Usuarios</h5>
                                    <p class="display-4">{{ users_count|default(0) }}</p>
                                    <a href="{{ path_for('admin.users') }}" class="btn btn-primary">Gestionar Usuarios</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card mb-4">
                                <div class="card-body text-center">
                                    <h5 class="card-title">Reservas</h5>
                                    <p class="display-4">{{ bookings_count|default(0) }}</p>
                                    <a href="{{ path_for('admin.bookings') }}" class="btn btn-primary">Gestionar Reservas</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
