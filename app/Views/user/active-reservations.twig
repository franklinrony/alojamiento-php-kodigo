{% extends "layouts/main.twig" %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">{{ pageTitle }}</h1>
                <a href="/user/reservations" class="btn btn-outline-primary">
                    <i class="fas fa-list"></i> Ver Todas las Reservas
                </a>
            </div>

            {% if reservations %}
            <div class="row">
                {% for reservation in reservations %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-success">
                        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-success">Activa</span>
                            <small>#{{ reservation.id }}</small>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title text-success">{{ reservation.accommodation.name }}</h5>
                            <p class="card-text text-muted">{{ reservation.accommodation.location }}</p>
                            
                            <div class="mb-3">
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted">Check-in</small>
                                        <div class="fw-bold">{{ reservation.check_in_date|date('d/m/Y') }}</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Check-out</small>
                                        <div class="fw-bold">{{ reservation.check_out_date|date('d/m/Y') }}</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted">Huéspedes</small>
                                        <div class="fw-bold">{{ reservation.guests }}</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Noches</small>
                                        <div class="fw-bold">{{ reservation.nights }}</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Contador de días -->
                            <div class="alert alert-info py-2 mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="mb-0">
                                        {% set daysUntilCheckin = (reservation.check_in_date|date('U') - 'now'|date('U')) / 86400 %}
                                        {% if daysUntilCheckin > 0 %}
                                            <i class="fas fa-clock"></i> {{ daysUntilCheckin|round }} días para el check-in
                                        {% elseif daysUntilCheckin > -1 %}
                                            <i class="fas fa-calendar-check"></i> Check-in hoy
                                        {% else %}
                                            <i class="fas fa-home"></i> Ya en el alojamiento
                                        {% endif %}
                                    </small>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Total</small>
                                    <div class="h5 text-primary mb-0">${{ reservation.getTotalPrice()|number_format(2) }}</div>
                                </div>
                                <div>
                                    <small class="text-muted">Creada</small>
                                    <div class="small">{{ reservation.created_at|date('d/m/Y') }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="d-flex justify-content-between">
                                <a href="/user/reservations/details?id={{ reservation.id }}" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye"></i> Ver Detalles
                                </a>
                                <form method="POST" action="/user/reservations/cancel" class="d-inline">
                                    <input type="hidden" name="reservation_id" value="{{ reservation.id }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" 
                                            onclick="return confirm('¿Estás seguro de que quieres cancelar esta reserva?')">
                                        <i class="fas fa-times"></i> Cancelar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="text-center py-5">
                <i class="fas fa-calendar-check fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No tienes reservas activas</h4>
                <p class="text-muted">Explora nuestros alojamientos disponibles y haz tu próxima reserva</p>
                <a href="/" class="btn btn-primary">Explorar Alojamientos</a>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
