			<!-- Flash Messages -->
			<div class="container mt-3">
				{% for type, messages in flash %}
					{% for message in messages %}
						{% set alertType = type == 'error' ? 'danger' : type %}
						<div class="alert alert-{{ alertType }} alert-dismissible fade show" role="alert">
							{% if type == 'success' %}
								<i class="bi bi-check-circle-fill me-2"></i>
							{% elseif type == 'error' %}
								<i class="bi bi-exclamation-triangle-fill me-2"></i>
							{% elseif type == 'info' %}
								<i class="bi bi-info-circle-fill me-2"></i>
							{% elseif type == 'warning' %}
								<i class="bi bi-exclamation-circle-fill me-2"></i>
							{% endif %}
							{{ message }}
							<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
						</div>
					{% endfor %}
				{% endfor %}
			</div>

			<!-- Main Content -->
			<main class="container py-4 flex-shrink-0"> {% block content %}{% endblock %}
				</main>

				<!-- Footer -->
				<footer class="footer mt-auto py-3 bg-dark text-white">
					<div class="container">
						<div class="row">
							<div class="col-md-6">
								<h5>{{ app_name }}</h5>
								<p class="mb-0">Tu plataforma confiable para encontrar alojamiento.</p>
							</div>
							<div class="col-md-6 text-md-end">
								<p class="mb-0">&copy;
									{{ "now"|date("Y") }}
									{{ app_name }}. Todos los derechos reservados.</p>
							</div>
						</div>
					</div>
				</footer>

				<!-- Bootstrap 5 JS -->
				<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

				<!-- Custom JS -->
				{% block scripts %}{% endblock %}
			</body>
		</html>
	{% endif %}
