{% extends "layouts/simple.twig" %}

{% block title %}Error del Servidor - Alojamientos{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card">
                <div class="card-body py-5">
                    <h1 class="display-1 text-danger">500</h1>
                    <h2 class="mb-4">Error del Servidor</h2>
                    
                    <div class="alert alert-danger">
                        <h4>Ha ocurrido un error interno del servidor</h4>
                        <p class="mb-0">
                            {% if debug %}
                                <strong>Detalles del error:</strong><br>
                                <code>{{ error }}</code>
                            {% else %}
                                Por favor, inténtalo de nuevo más tarde. Si el problema persiste, contacta al administrador.
                            {% endif %}
                        </p>
                    </div>
                    
                    <div class="mt-4">
                        <a href="/" class="btn btn-primary">
                            <i class="bi bi-house-door me-2"></i>Volver al Inicio
                        </a>
                        <button onclick="history.back()" class="btn btn-outline-secondary ms-2">
                            <i class="bi bi-arrow-left me-2"></i>Volver Atrás
                        </button>
                    </div>
                    
                    {% if debug %}
                        <div class="mt-4">
                            <details>
                                <summary>Información de Debug</summary>
                                <pre class="text-left mt-2"><code>{{ error }}</code></pre>
                            </details>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
