<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error del Servidor - Alojamientos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            padding: 50px 0;
        }
        .error-container {
            max-width: 600px;
            margin: 0 auto;
            text-align: center;
        }
        .error-code {
            font-size: 4rem;
            font-weight: bold;
            color: #dc2626;
            margin-bottom: 1rem;
        }
        .error-message {
            color: #64748b;
            margin-bottom: 2rem;
        }
        .btn {
            padding: 0.5rem 1.5rem;
            border-radius: 0.375rem;
            text-decoration: none;
            display: inline-block;
            margin: 0.25rem;
        }
        .btn-primary {
            background-color: #2563eb;
            color: white;
            border: 1px solid #2563eb;
        }
        .btn-primary:hover {
            background-color: #1d4ed8;
            color: white;
        }
        .btn-secondary {
            background-color: #6b7280;
            color: white;
            border: 1px solid #6b7280;
        }
        .btn-secondary:hover {
            background-color: #4b5563;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="error-container">
            <div class="error-code">{{ errorCode|default('500') }}</div>
            <h1>{{ errorTitle|default('Error del Servidor') }}</h1>
            <p class="error-message">{{ errorMessage|default('Ha ocurrido un error interno del servidor') }}</p>
            
            <div>
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house-door me-2"></i>Volver al Inicio
                </a>
                <button onclick="history.back()" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Volver Atrás
                </button>
            </div>
            
            {% if debug and errorDetails %}
                <div style="margin-top: 2rem; text-align: left;">
                    <details>
                        <summary>Información de Debug</summary>
                        <pre style="background: #f1f5f9; padding: 1rem; border-radius: 0.375rem; margin-top: 1rem;"><code>{{ errorDetails }}</code></pre>
                    </details>
                </div>
            {% endif %}
        </div>
    </div>
</body>
</html>
