{% extends "layouts/simple.twig" %}

{% block title %}Error de Conexión - Alojamientos{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card">
                <div class="card-body py-5">
                    <h1 class="display-1 text-warning">⚠️</h1>
                    <h2 class="mb-4">Error de Conexión a la Base de Datos</h2>
                    
                    <div class="alert alert-warning">
                        <h4>Servicio Temporalmente No Disponible</h4>
                        <p class="mb-0">
                            No se puede establecer conexión con la base de datos. 
                            Esto puede deberse a que el servidor de base de datos no esté ejecutándose 
                            o haya un problema de configuración.
                        </p>
                    </div>
                    
                    <div class="mt-4">
                        <a href="/" class="btn btn-primary">
                            <i class="bi bi-house-door me-2"></i>Volver al Inicio
                        </a>
                        <button onclick="location.reload()" class="btn btn-outline-secondary ms-2">
                            <i class="bi bi-arrow-clockwise me-2"></i>Reintentar
                        </button>
                    </div>
                    
                    {% if debug %}
                        <div class="mt-4">
                            <details>
                                <summary>Información Técnica</summary>
                                <div class="alert alert-info text-left mt-2">
                                    <strong>Error:</strong><br>
                                    <code>{{ error }}</code>
                                </div>
                            </details>
                        </div>
                    {% endif %}
                    
                    <div class="mt-4 text-muted">
                        <small>
                            <i class="bi bi-info-circle me-1"></i>
                            Si el problema persiste, contacta al administrador del sistema.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
