{% extends "layouts/main.twig" %}

{% block title %}Alojamientos Disponibles - {{ parent() }}{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center mb-4">Alojamientos Disponibles</h1>
            <p class="text-center text-muted mb-5">Explora nuestra selección de alojamientos</p>
            
            {% if accommodations %}
                <div class="row">
                    {% for accommodation in accommodations %}
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <i class="bi bi-house display-4 text-muted"></i>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">{{ accommodation.name }}</h5>
                                    <p class="card-text text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        {{ accommodation.location }}
                                    </p>
                                    {% if accommodation.description %}
                                        <p class="card-text flex-grow-1">
                                            {{ accommodation.description|length > 100 ? accommodation.description|slice(0, 100) ~ '...' : accommodation.description }}
                                        </p>
                                    {% endif %}
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-success fw-bold fs-5">
                                                ${{ accommodation.price|number_format(2) }}
                                                <small class="text-muted">por noche</small>
                                            </span>
                                            <a href="{{ path_for('/accommodations/' ~ accommodation.id) }}" class="btn btn-primary btn-sm">
                                                <i class="bi bi-eye me-1"></i>Ver Detalles
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-house display-1 text-muted"></i>
                    <h3 class="mt-3">No hay alojamientos disponibles</h3>
                    <p class="text-muted">Pronto tendremos nuevas opciones para ti.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
