{% extends "layouts/main.twig" %}

{% block content %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center mb-4">{{ accommodation.name }}</h1>
            <p class="text-center text-muted mb-5">{{ accommodation.location }}</p>
            
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h2 class="card-title">Información del Alojamiento</h2>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Nombre:</label>
                                        <p class="form-control-plaintext">{{ accommodation.name }}</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Ubicación:</label>
                                        <p class="form-control-plaintext">{{ accommodation.location }}</p>
                                    </div>
                                </div>
                            </div>

                            {% if accommodation.description %}
                            <div class="mb-3">
                                <label class="form-label fw-bold">Descripción:</label>
                                <p class="form-control-plaintext">{{ accommodation.description }}</p>
                            </div>
                            {% endif %}

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Precio por Noche:</label>
                                        <p class="form-control-plaintext text-success fw-bold fs-4">${{ accommodation.price|number_format(2) }}</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Fecha de Creación:</label>
                                        <p class="form-control-plaintext">{{ accommodation.created_at|date('d/m/Y H:i') }}</p>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <a href="{{ path_for('/accommodations') }}" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-2"></i>Volver a la Lista
                                </a>
                                
                                <div class="btn-group">
                                    {% if auth.user %}
                                        <a href="{{ path_for('/user/reservations/create') }}?accommodation_id={{ accommodation.id }}" class="btn btn-primary">
                                            <i class="bi bi-calendar-plus me-2"></i>Reservar
                                        </a>
                                    {% else %}
                                        <a href="{{ path_for('/auth/login') }}" class="btn btn-primary">
                                            <i class="bi bi-person-plus me-2"></i>Iniciar Sesión para Reservar
                                        </a>
                                    {% endif %}
                                </div>
                                
                                {% if auth.user and auth.user.id == accommodation.created_by %}
                                    <div class="btn-group">
                                        <a href="{{ path_for('/accommodations/' ~ accommodation.id ~ '/edit') }}" class="btn btn-warning">
                                            <i class="bi bi-pencil me-2"></i>Editar
                                        </a>
                                    </div>
                                {% endif %}
                                
                                {% if auth.user and auth.hasPermission('manage-accommodations') %}
                                    <div class="btn-group">
                                        <a href="{{ path_for('/admin/accommodations/' ~ accommodation.id ~ '/edit') }}" class="btn btn-warning">
                                            <i class="bi bi-pencil me-2"></i>Editar (Admin)
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
